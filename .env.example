# ==============================================================================
# Aiven MySQL Database Configuration
# Get your connection details from your Aiven Console (https://console.aiven.io)
# ==============================================================================

# Option 1: Full Aiven MySQL JDBC Connection URL
# Format: jdbc:mysql://[host]:[port]/[database]?sslMode=REQUIRED
SPRING_DATASOURCE_URL=jdbc:mysql://mysql-your-project-name.aivencloud.com:PORT/defaultdb?sslMode=REQUIRED
SPRING_DATASOURCE_USERNAME=avnadmin
SPRING_DATASOURCE_PASSWORD=YOUR_AIVEN_MYSQL_PASSWORD

# Option 2: Individual Connection Parameters (if needed by your tools)
MYSQL_HOST=mysql-your-project-name.aivencloud.com
MYSQL_PORT=12345
MYSQL_DATABASE=defaultdb
MYSQL_USER=avnadmin
MYSQL_PASSWORD=YOUR_AIVEN_MYSQL_PASSWORD
MYSQL_SSL_MODE=REQUIRED

# Server Configuration
SERVER_PORT=8080

# Frontend API URL
VITE_API_BASE_URL=http://localhost:8080/api/v1
