# ==============================================================================
# Neon PostgreSQL Database Configuration
# Get your connection details from your Neon Console (https://console.neon.tech)
# ==============================================================================

# Option 1: Full Neon Connection URL
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Option 2: Individual Spring Boot DataSource Properties
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-sample-pooler.us-east-2.aws.neon.tech:5432/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=YOUR_NEON_PASSWORD

# Server Configuration
SERVER_PORT=8080

# Frontend API URL
VITE_API_BASE_URL=http://localhost:8080/api/v1
