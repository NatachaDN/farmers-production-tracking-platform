# ==============================================================================
# Aiven MySQL Database Configuration
# Get your connection details from your Aiven Console (https://console.aiven.io)
# ==============================================================================

# Option 1: Full Aiven MySQL JDBC Connection URL
# Format: jdbc:mysql://[host]:[port]/[database]?sslMode=REQUIRED
SPRING_DATASOURCE_URL=jdbc:mysql://mysql-your-project-name.aivencloud.com:PORT/defaultdb?sslMode=REQUIRED
SPRING_DATASOURCE_USERNAME=avnadmin
SPRING_DATASOURCE_PASSWORD=YOUR_AIVEN_MYSQL_PASSWORD

# Option 2: Individual Connection Parameters (if needed by your tools)
MYSQL_HOST=mysql-your-project-name.aivencloud.com
MYSQL_PORT=12345
MYSQL_DATABASE=defaultdb
MYSQL_USER=avnadmin
MYSQL_PASSWORD=YOUR_AIVEN_MYSQL_PASSWORD
MYSQL_SSL_MODE=REQUIRED

# Server Configuration
SERVER_PORT=8080

# Frontend API URL
VITE_API_BASE_URL=/api/v1

# ==============================================================================
# Google sign-in (OAuth 2.0) - https://console.cloud.google.com/apis/credentials
# Create an "OAuth client ID" of type "Web application" and add the redirect URI
#   http://localhost:5173/auth/google/callback   (and your production URL)
# ==============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URIS=http://localhost:5173/auth/google/callback,http://127.0.0.1:5173/auth/google/callback

# Password reset email (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Set this to a sender authorized by your provider, or omit it to use MAIL_USERNAME.
# MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_SMTP_SSL=false

# ==============================================================================
# Admin console
# ==============================================================================
# Emails promoted to ROLE_ADMIN when they sign in with Google (comma-separated)
ADMIN_EMAILS=
# Optional: email + password admin account created at startup
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
# Keep review enabled for production. Disable only for local testing of self-service access.
APP_REGISTRATION_REVIEW_REQUIRED=true
# Set only when the frontend and API use separate origins.
# APP_CORS_ALLOWED_ORIGINS=https://app.example.com
