# ==============================================================================
# Aiven MySQL Database Configuration
# ==============================================================================

# Full Aiven MySQL JDBC Connection URL
SPRING_DATASOURCE_URL=jdbc:mysql://your-host.aivencloud.com:21627/defaultdb?sslMode=REQUIRED
SPRING_DATASOURCE_USERNAME=avnadmin
SPRING_DATASOURCE_PASSWORD=YOUR_AIVEN_PASSWORD
SPRING_DATASOURCE_DRIVER=com.mysql.cj.jdbc.Driver

# Individual Connection Parameters
MYSQL_HOST=your-host.aivencloud.com
MYSQL_PORT=21627
MYSQL_DATABASE=defaultdb
MYSQL_USER=avnadmin
MYSQL_PASSWORD=YOUR_AIVEN_PASSWORD
MYSQL_SSL_MODE=REQUIRED

# Server Configuration
SERVER_PORT=8080

# Frontend API URL
VITE_API_BASE_URL=http://localhost:8080/api/v1
